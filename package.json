{
  "name": "@lbk0523/samantha",
  "version": "0.1.0",
  "type": "module",
  "description": "Local harness for verifying agent-produced code before accepting it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbk0523/samantha.git"
  },
  "bugs": {
    "url": "https://github.com/lbk0523/samantha/issues"
  },
  "homepage": "https://github.com/lbk0523/samantha#readme",
  "keywords": [
    "agent",
    "codex",
    "harness",
    "verification",
    "trust-loop",
    "worktree"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "samantha": "dist/cli.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "dist/",
    "examples/first-run-demo/fixture-repo/",
    "references/agent-profiles/codex-worker.json"
  ],
  "scripts": {
    "samantha": "bun run src/cli.ts",
    "build": "rm -rf dist && bun build src/cli.ts --target=bun --packages=external --outfile=dist/cli.js && chmod +x dist/cli.js",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.130.0"
  }
}
